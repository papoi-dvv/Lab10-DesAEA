@model IEnumerable<Reserva>
@{
    ViewData["Title"] = "Reservas";
    var reservas = Model.ToList();
    var estado = ViewData["Estado"] as string;
    var conteos = ViewData["Conteos"] as Dictionary<string, int> ?? new Dictionary<string, int>();

    int Conteo(string e) => conteos.TryGetValue(e, out var n) ? n : 0;

    string ClaseChip(string e) => e switch
    {
        "Pendiente" => "chip chip-pendiente",
        "Confirmada" => "chip chip-confirmada",
        "Cancelada" => "chip chip-cancelada",
        _ => "chip chip-finalizada"
    };
}

<div class="encabezado">
    <div>
        <h1 class="h3">Reservas</h1>
        <div class="sub">Las reservas Pendiente o Confirmada se pueden cancelar (pasan a <em>Cancelada</em>).</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Disponibles" class="btn btn-outline-secondary">Disponibilidad</a>
        <a asp-action="Create" class="btn btn-primary">＋ Nueva reserva</a>
    </div>
</div>

<div class="kpis">
    <div class="kpi oro">
        <div class="valor"><span data-contar="@Conteo("Pendiente")">0</span></div>
        <div class="rotulo">Pendientes</div>
    </div>
    <div class="kpi verde">
        <div class="valor"><span data-contar="@Conteo("Confirmada")">0</span></div>
        <div class="rotulo">Confirmadas</div>
    </div>
    <div class="kpi azul">
        <div class="valor"><span data-contar="@Conteo("Finalizada")">0</span></div>
        <div class="rotulo">Finalizadas</div>
    </div>
    <div class="kpi rojo">
        <div class="valor"><span data-contar="@Conteo("Cancelada")">0</span></div>
        <div class="rotulo">Canceladas</div>
    </div>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-sm-6 col-md-4">
        <label for="estado" class="form-label">Estado</label>
        <select id="estado" name="estado" class="form-select">
            <option value="">Todos los estados</option>
            @foreach (var e in ReservaRepositorio.Estados)
            {
                <option value="@e" selected="@(estado == e)">@e</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        @if (!string.IsNullOrEmpty(estado))
        {
            <a asp-action="Index" class="btn btn-link">Quitar filtro</a>
        }
    </div>
</form>

<div class="glass panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Huésped</th>
                    <th>Habitación</th>
                    <th>Ingreso</th>
                    <th>Salida</th>
                    <th class="text-center">Noches</th>
                    <th class="text-end">Total</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < reservas.Count; i++)
                {
                    var r = reservas[i];
                    var noches = r.FechaSalida.DayNumber - r.FechaIngreso.DayNumber;
                    var total = noches * r.Habitacion.TipoHabitacion.PrecioNoche;
                    var cancelable = r.Estado == "Pendiente" || r.Estado == "Confirmada";
                    <tr style="--i:@i">
                        <td class="numero text-secondary">@r.ReservaId</td>
                        <td>
                            <div class="fw-semibold">@r.Huesped.Apellidos, @r.Huesped.Nombres</div>
                            <div class="tl-sub">DNI @r.Huesped.Dni</div>
                            @if (!string.IsNullOrWhiteSpace(r.Observaciones))
                            {
                                <div class="tl-sub" title="@r.Observaciones">📝 @r.Observaciones</div>
                            }
                        </td>
                        <td>
                            <span class="cod-habitacion">@r.Habitacion.Numero</span>
                            <div class="tl-sub mt-1">@r.Habitacion.TipoHabitacion.Nombre</div>
                        </td>
                        <td class="numero">@r.FechaIngreso.ToString("dd/MM/yyyy")</td>
                        <td class="numero">@r.FechaSalida.ToString("dd/MM/yyyy")</td>
                        <td class="text-center numero">@noches</td>
                        <td class="text-end numero">S/ @total.ToString("N2")</td>
                        <td><span class="@ClaseChip(r.Estado)">@r.Estado</span></td>
                        <td class="text-end">
                            @if (cancelable)
                            {
                                <form asp-action="Cancelar" asp-route-id="@r.ReservaId" method="post" class="d-inline frmCancelar">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            data-reserva="@r.ReservaId"
                                            data-detalle="Habitación @r.Habitacion.Numero · @r.Huesped.Nombres @r.Huesped.Apellidos · @r.FechaIngreso.ToString("dd/MM/yyyy") → @r.FechaSalida.ToString("dd/MM/yyyy")">Cancelar</button>
                                </form>
                            }
                            else
                            {
                                <span class="chip chip-neutro">Sin acciones</span>
                            }
                        </td>
                    </tr>
                }
                @if (reservas.Count == 0)
                {
                    <tr>
                        <td colspan="9">
                            <div class="vacio">
                                <span class="icono">📋</span>
                                @(string.IsNullOrEmpty(estado)
                                    ? "Todavía no hay reservas registradas."
                                    : $"No hay reservas en estado {estado}.")
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalCancelar" tabindex="-1" aria-labelledby="modalCancelarTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h6" id="modalCancelarTitulo">Cancelar reserva</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">¿Seguro que desea cancelar la reserva <strong id="mcNumero"></strong>?</p>
                <p class="tl-sub mb-0" id="mcDetalle"></p>
                <p class="tl-sub mt-2 mb-0">El estado pasará a <span class="chip chip-cancelada">Cancelada</span></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Volver</button>
                <button type="button" class="btn btn-danger" id="mcConfirmar">Sí, cancelar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Confirmación en un modal antes de cancelar una reserva.
        (function () {
            const modalEl = document.getElementById('modalCancelar');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            let formulario = null;
            let confirmado = false;

            document.querySelectorAll('.frmCancelar').forEach(function (f) {
                f.addEventListener('submit', function (e) {
                    if (confirmado) return;            // ya confirmada
                    e.preventDefault();
                    formulario = f;
                    const boton = f.querySelector('button[data-reserva]');
                    document.getElementById('mcNumero').textContent = '#' + boton.dataset.reserva;
                    document.getElementById('mcDetalle').textContent = boton.dataset.detalle;
                    modal.show();
                });
            });

            document.getElementById('mcConfirmar').addEventListener('click', function () {
                confirmado = true;
                modal.hide();
                formulario?.requestSubmit();
            });
        })();
    </script>
}
